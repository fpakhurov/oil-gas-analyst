# === LLM (обязательно) ===
ANTHROPIC_API_KEY=sk-ant-...
# Модель и «усилие» рассуждений (low | medium | high | xhigh | max)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
# Server-side fallback при срабатывании классификатора безопасности (beta)
LLM_REFUSAL_FALLBACK=true
# Prompt caching: инструменты, системный промпт и история переиспользуются (дешевле и быстрее)
LLM_PROMPT_CACHING=true
# Жёсткий дневной лимит расходов на LLM, $ (0 — без лимита)
DAILY_BUDGET_USD=10
# Перевод резюме рассуждений (API отдаёт их по-английски) на язык вопроса дешёвой моделью
REASONING_TRANSLATION=true
AUX_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# === Веб-поиск ===
# Если ключа нет — используется DuckDuckGo (без ключа, но менее стабильно)
TAVILY_API_KEY=
WEB_MAX_RESULTS=6

# === RAG ===
# корень: reports/, chroma/, prices/
# DATA_DIR=./data
# или intfloat/multilingual-e5-base / -large
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# cpu | cuda | mps
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_RELEVANCE_THRESHOLD=0.84

# === Расчётный модуль ===
PRICE_HISTORY_YEARS=12
GLOBAL_SUPPLY_MBD=104.0

# === Хранилище и автообновление ===
# История диалогов и учёт расходов — SQLite в DATA_DIR (checkpoints.sqlite, app.sqlite)
# Автообновление базы отчётов и снимка цен, дней (0 — выключено)
REFRESH_INTERVAL_DAYS=7

# === Трейсинг: Langfuse (self-hosted, поднимается в docker compose) ===
# Всё ниже заполняет `python scripts/init_env.py` — вручную ничего вписывать не нужно
LANGFUSE_ENABLED=false
COMPOSE_PROFILES=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Для запуска без Docker: адрес Langfuse для SDK и для ссылок в UI
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_UI_URL=http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=admin@local.test
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
